# Copy to .env for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables (never commit real values).

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=pac_lab

# Hosted MySQL (Aiven, TiDB Cloud, …): turn on TLS. Paste the provider's CA certificate into
# DB_SSL_CA when it is not publicly trusted (Aiven); literal \n line breaks are accepted.
DB_SSL=false
DB_SSL_CA=

# Signs sign-in tokens. Required in production; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local API server port (Vite proxies /api to it)
API_PORT=8787

# Optional: classroom invite emails. Without these, teachers send invites from their own email.
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an app password as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address when it differs from SMTP_USER (it must be allowed to send for that account).
MAIL_FROM=
# Site address used in invite links, e.g. https://pac-lab.vercel.app (defaults to the address in use).
APP_URL=
