# Copy to .env for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables (never commit real values).

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=pac_lab

# Hosted MySQL (Aiven, TiDB Cloud, …): turn on TLS. Paste the provider's CA certificate into
# DB_SSL_CA when it is not publicly trusted (Aiven); literal \n line breaks are accepted.
DB_SSL=false
DB_SSL_CA=

# Signs sign-in tokens. Required in production; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local API server port (Vite proxies /api to it)
API_PORT=8787
